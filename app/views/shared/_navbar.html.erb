<nav class="fixed top-0 z-40 w-full bg-white border-b border-gray-200 lg:pl-64">
  <div class="px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center lg:hidden">
        <%= link_to root_path, class: "text-xl font-bold text-indigo-600" do %>
          🎯 Sankalp
        <% end %>
      </div>

      <div class="flex-1 flex justify-end items-center space-x-4">
        <!-- Rewards Notification -->
        <% unread_count = current_user.rewards.unread.count %>
        <!-- Rewards Notification -->
        <% unread_count = current_user.rewards.unread.count %>
        <div class="relative" data-controller="dropdown">
          <button type="button" data-action="click->dropdown#toggle" onclick="this.querySelector('.absolute.top-1.right-1')?.remove()" class="relative p-2 text-gray-400 hover:text-gray-500 group focus:outline-none transition-colors">
            <span class="sr-only">View notifications</span>
            <svg class="h-6 w-6 group-hover:text-indigo-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
            </svg>
            <% if unread_count > 0 %>
              <span class="absolute top-1 right-1 flex h-4 w-4 pointer-events-none">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex h-4 w-4 rounded-full bg-red-500 text-[10px] font-bold text-white items-center justify-center shadow-sm">
                  <%= unread_count > 9 ? '9+' : unread_count %>
                </span>
              </span>
            <% end %>
          </button>

          <!-- Dropdown Menu -->
          <div data-dropdown-target="menu" class="hidden absolute right-0 mt-3 w-80 sm:w-96 origin-top-right rounded-xl bg-white shadow-xl ring-1 ring-black/5 focus:outline-none z-50 overflow-hidden transform transition-all">
            <div class="px-5 py-3 border-b border-gray-100 flex justify-between items-center bg-gray-50/50 backdrop-blur-sm">
               <span class="text-sm font-semibold text-gray-900">Notifications</span>
               <% if unread_count > 0 %>
                 <span class="inline-flex items-center rounded-full bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10"><%= unread_count %> new</span>
               <% end %>
            </div>
            
            <div class="max-h-[28rem] overflow-y-auto scrollbar-thin scrollbar-thumb-gray-200">
              <% rewards = current_user.rewards.recent.limit(5) %>
              <% if rewards.any? %>
                <ul class="divide-y divide-gray-50">
                  <% rewards.each do |reward| %>
                     <li>
                       <%= link_to reward_path(reward), class: "group block px-5 py-4 hover:bg-gray-50 transition-colors" do %>
                         <div class="flex items-start">
                           <div class="flex-shrink-0 pt-0.5">
                             <% if reward.read? %>
                                <span class="h-2.5 w-2.5 rounded-full bg-gray-200 block mt-1.5 ring-2 ring-white"></span>
                             <% else %>
                                <span class="h-2.5 w-2.5 rounded-full bg-indigo-600 block mt-1.5 ring-2 ring-white shadow-sm group-hover:bg-indigo-700 transition-colors"></span>
                             <% end %>
                           </div>
                           <div class="ml-4 flex-1">
                              <p class="text-sm font-semibold text-gray-900 group-hover:text-indigo-600 transition-colors"><%= reward.title %></p>
                              <p class="text-sm text-gray-500 mt-0.5 line-clamp-2 leading-relaxed"><%= reward.message %></p>
                              <p class="text-xs text-gray-400 mt-2 font-medium"><%= time_ago_in_words(reward.created_at) %> ago</p>
                           </div>
                         </div>
                       <% end %>
                     </li>
                  <% end %>
                </ul>
              <% else %>
                <div class="px-5 py-8 text-center bg-gray-50/30">
                  <div class="mx-auto h-12 w-12 text-gray-300 mb-3">
                     <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                     </svg>
                  </div>
                  <p class="text-sm text-gray-500 font-medium">No new notifications</p>
                </div>
              <% end %>
            </div>
            
            <div class="border-t border-gray-100 bg-gray-50 p-2">
              <%= link_to "View all awards", profile_path(anchor: "awards"), class: "block w-full rounded-lg px-4 py-2 text-center text-sm font-semibold text-indigo-600 hover:text-indigo-700 hover:bg-white hover:shadow-sm transition-all" %>
            </div>
          </div>
        </div>

        <% if current_user.admin? %>
          <%= link_to admin_root_path, class: "inline-flex items-center px-3 py-1.5 text-sm font-medium text-purple-700 bg-purple-100 rounded-full hover:bg-purple-200 transition-colors" do %>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Admin
          <% end %>
        <% end %>

        <button type="button" id="mobile-menu-button" data-controller="sidebar" data-action="click->sidebar#open" class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500">
          <span class="sr-only">Open sidebar</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>
