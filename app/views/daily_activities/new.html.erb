<% content_for :title, "Log Activity - #{@sankalp.title}" %>

<div class="max-w-xl mx-auto">
  <div class="mb-6">
    <%= link_to @sankalp, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
      <svg class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
      </svg>
      Back to <%= @sankalp.title %>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">Log Activity</h1>
    <p class="mt-1 text-sm text-gray-500">Record your progress for <%= @sankalp.title %>.</p>
  </div>

  <%= render "form", daily_activity: @daily_activity, sankalp: @sankalp %>
</div>
