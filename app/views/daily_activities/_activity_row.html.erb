<div id="activity_<%= activity.id %>" class="px-6 py-4 hover:bg-gray-50 transition-colors">
  <div class="flex items-center justify-between">
    <div class="flex items-center min-w-0 flex-1">
      <%= button_to toggle_sankalp_daily_activity_path(sankalp, activity), method: :post, class: "flex-shrink-0 mr-4", data: { turbo_frame: "activity_#{activity.id}" } do %>
        <% if activity.completed %>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-green-100 text-green-600 hover:bg-green-200 transition-colors">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </span>
        <% else %>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-gray-100 text-gray-400 hover:bg-gray-200 transition-colors">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </span>
        <% end %>
      <% end %>
      
      <%= link_to sankalp_daily_activity_path(sankalp, activity), class: "min-w-0 flex-1 block group/link" do %>
        <div class="flex items-center gap-3">
          <p class="text-sm font-medium text-gray-900 group-hover/link:text-indigo-600 transition-colors"><%= format_date(activity.activity_date) %></p>
          <% if activity.activity_date == Date.current %>
            <span class="inline-flex items-center rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-700">Today</span>
          <% end %>
        </div>
        <% if activity.notes.present? %>
          <p class="mt-1 text-sm text-gray-500"><%= activity.notes %></p>
        <% end %>
      <% end %>
    </div>
    
    <div class="flex items-center gap-2 ml-4">
      <%= link_to edit_sankalp_daily_activity_path(sankalp, activity), class: "text-gray-400 hover:text-gray-500 p-1" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
        </svg>
      <% end %>
      <%= button_to sankalp_daily_activity_path(sankalp, activity), method: :delete, class: "text-gray-400 hover:text-red-500 p-1", data: { turbo_confirm: "Are you sure?" } do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
      <% end %>
    </div>
  </div>
</div>
