<% content_for :title, "#{@sankalp.title} - Sankalp" %>

<div class="space-y-6">
  <!-- Breadcrumb -->
  <nav class="flex" aria-label="Breadcrumb">
    <ol role="list" class="flex items-center space-x-4">
      <li>
        <div>
          <%= link_to sankalps_path, class: "text-gray-400 hover:text-gray-500" do %>
            <svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" />
            </svg>
            <span class="sr-only">Sankalps</span>
          <% end %>
        </div>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="h-5 w-5 flex-shrink-0 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
            <path d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z" />
          </svg>
          <span class="ml-4 text-sm font-medium text-gray-500"><%= truncate(@sankalp.title, length: 30) %></span>
        </div>
      </li>
    </ol>
  </nav>

  <!-- Header -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-5" style="background: linear-gradient(135deg, <%= @sankalp.category.color %>20, <%= @sankalp.category.color %>05);">
      <div class="flex items-start justify-between">
        <div>
          <div class="flex items-center gap-3">
            <span class="inline-block w-4 h-4 rounded-full" style="background-color: <%= @sankalp.category.color %>"></span>
            <span class="text-sm font-medium text-gray-600"><%= @sankalp.category.name %></span>
            <%= status_badge(@sankalp.status) %>
          </div>
          <h1 class="mt-3 text-2xl font-bold text-gray-900"><%= @sankalp.title %></h1>
          <% if @sankalp.description.present? %>
            <p class="mt-2 text-gray-600"><%= @sankalp.description %></p>
          <% end %>
        </div>
        <div class="flex items-center gap-2">
          <%= link_to edit_sankalp_path(@sankalp), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
            <svg class="-ml-0.5 mr-1.5 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
            </svg>
            Edit
          <% end %>
          <%= button_to sankalp_path(@sankalp), method: :delete, class: "inline-flex items-center rounded-md bg-red-50 px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-100", data: { turbo_confirm: "Are you sure you want to delete this Sankalp?" } do %>
            <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
            </svg>
            Delete
          <% end %>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="border-t border-gray-100 px-6 py-4 grid grid-cols-2 md:grid-cols-4 gap-4">
      <div>
        <p class="text-sm text-gray-500">Start Date</p>
        <p class="mt-1 text-lg font-semibold text-gray-900"><%= format_short_date(@sankalp.start_date) %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">End Date</p>
        <p class="mt-1 text-lg font-semibold text-gray-900"><%= @sankalp.end_date.present? ? format_short_date(@sankalp.end_date) : "Ongoing" %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Current Streak</p>
        <p class="mt-1 text-lg font-semibold text-orange-500">🔥 <%= @sankalp.current_streak %> days</p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Longest Streak</p>
        <p class="mt-1 text-lg font-semibold text-purple-600">🏆 <%= @sankalp.longest_streak %> days</p>
      </div>
    </div>

    <!-- Progress -->
    <div class="border-t border-gray-100 px-6 py-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-gray-700">Overall Progress</span>
        <span class="text-sm font-bold text-indigo-600"><%= @sankalp.completion_percentage %>%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-3">
        <div class="bg-gradient-to-r from-indigo-500 to-purple-600 h-3 rounded-full transition-all duration-500" style="width: <%= @sankalp.completion_percentage %>%"></div>
      </div>
      <div class="mt-2 flex justify-between text-xs text-gray-500">
        <span><%= @sankalp.completed_days %> days completed</span>
        <span><%= @sankalp.total_days %> total days</span>
      </div>
    </div>
  </div>

  <!-- Daily Activities Section -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">Daily Activities</h2>
      <%= link_to new_sankalp_daily_activity_path(@sankalp), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
        <svg class="-ml-0.5 mr-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        Log Activity
      <% end %>
    </div>

    <div class="divide-y divide-gray-100" id="daily-activities">
      <% if @daily_activities.any? %>
        <% @daily_activities.each do |activity| %>
          <%= render "daily_activities/activity_row", activity: activity, sankalp: @sankalp %>
        <% end %>
      <% else %>
        <div class="px-6 py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-gray-900">No activities yet</h3>
          <p class="mt-1 text-sm text-gray-500">Start logging your daily progress.</p>
          <div class="mt-4">
            <%= link_to new_sankalp_daily_activity_path(@sankalp, activity_date: Date.current), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
              Log Today's Activity
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    
    <%= render "shared/pagination" %>
  </div>
</div>
