<% content_for :title, "Reward - Sankalp" %>

<div class="min-h-[80vh] flex items-center justify-center p-4">
  <!-- Confetti Background Effect (CSS only) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-0 left-1/4 w-3 h-3 bg-yellow-400 rounded-full animate-[fall_3s_ease-in-out_infinite]"></div>
    <div class="absolute top-0 left-1/2 w-4 h-4 bg-purple-500 rounded-lg animate-[fall_2.5s_ease-in-out_infinite_0.5s]"></div>
    <div class="absolute top-0 left-3/4 w-3 h-3 bg-pink-500 transform rotate-45 animate-[fall_3.5s_ease-in-out_infinite_1s]"></div>
    <div class="absolute top-0 left-10 w-2 h-2 bg-blue-400 rounded-full animate-[fall_4s_ease-in-out_infinite_1.5s]"></div>
    <div class="absolute top-0 right-10 w-3 h-3 bg-red-400 rounded-lg animate-[fall_3.2s_ease-in-out_infinite_0.2s]"></div>
  </div>

  <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden transform hover:scale-[1.02] transition-transform duration-500 ring-1 ring-gray-900/5">
    <!-- Header with Gradient and Icon -->
    <div class="relative bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 pt-16 pb-12 px-8 text-center overflow-hidden">
      <!-- Decorative circles -->
      <div class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-white/10 rounded-full blur-xl"></div>
      <div class="absolute bottom-0 right-0 translate-x-1/3 translate-y-1/3 w-40 h-40 bg-white/20 rounded-full blur-2xl"></div>
      
      <div class="relative z-10 mx-auto w-24 h-24 bg-white/20 backdrop-blur-sm rounded-full p-2 mb-4 animate-[bounce_2s_infinite]">
        <div class="w-full h-full bg-white rounded-full flex items-center justify-center shadow-lg">
          <% if @reward.icon == 'trophy' %>
            <svg class="h-12 w-12 text-yellow-500 drop-shadow-sm" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0V5.625c0-.621-.503-1.125-1.125-1.125h-3.375c-.621 0-1.125.504-1.125 1.125v7.875m11.386-4.688c.063.296.107.586.106.883 0 2.228-1.724 4.099-3.921 4.365-2.197.266-4.444.695-6.612 1.258.552-2.167.971-4.402 1.238-6.586.27-2.179 2.152-3.886 4.38-3.864.293.003.58.043.874.103l2.935 3.84z" />
            </svg>
          <% else %>
             <svg class="h-12 w-12 text-yellow-500 drop-shadow-sm" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          <% end %>
        </div>
      </div>
      
      <h1 class="text-3xl font-bold text-white tracking-tight mb-2">Congratulations!</h1>
      <p class="text-indigo-100 text-sm font-medium uppercase tracking-wider"><%= @reward.created_at.strftime("%B %d, %Y") %></p>
    </div>

    <!-- Content -->
    <div class="px-8 py-8">
      <div class="text-center">
        <h2 class="text-xl font-bold text-gray-900 mb-3"><%= @reward.title %></h2>
        <p class="text-gray-600 leading-relaxed mb-8"><%= @reward.message %></p>
      </div>

      <% if @reward.sankalp %>
        <div class="bg-gray-50 rounded-xl p-4 mb-8 border border-gray-100 flex items-center">
           <div class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 mr-4">
             <span class="text-lg">🎯</span>
           </div>
           <div>
             <p class="text-xs text-gray-400 font-medium uppercase">Source</p>
             <%= link_to @reward.sankalp.title, sankalp_path(@reward.sankalp), class: "text-sm font-bold text-gray-900 hover:text-indigo-600 transition-colors" %>
           </div>
        </div>
      <% end %>

      <div class="flex flex-col space-y-3">
        <%= link_to "View My Profile", profile_path(anchor: "awards"), class: "w-full flex items-center justify-center px-4 py-3 border border-transparent text-sm font-semibold rounded-xl text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors shadow-lg shadow-indigo-200" %>
        <%= link_to "Back to Dashboard", root_path, class: "w-full flex items-center justify-center px-4 py-3 text-sm font-semibold text-gray-500 hover:text-gray-700 transition-colors" %>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes fall {
  0% { transform: translateY(-20px) rotate(0deg); opacity: 0; }
  10% { opacity: 1; }
  100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
}
</style>
