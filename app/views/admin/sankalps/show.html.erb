<% content_for :title, "#{@sankalp.title} - Admin" %>

<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <span class="inline-block w-4 h-4 rounded-full" style="background-color: <%= @sankalp.category.color %>"></span>
        <span class="text-sm text-gray-500"><%= @sankalp.category.name %></span>
        <%= status_badge(@sankalp.status) %>
      </div>
      <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= @sankalp.title %></h1>
      <p class="mt-1 text-sm text-gray-500">
        by <%= link_to @sankalp.user.full_name, admin_user_path(@sankalp.user), class: "text-indigo-600 hover:text-indigo-900" %>
      </p>
    </div>
    <div class="mt-4 flex space-x-3 sm:mt-0">
      <%= link_to edit_admin_sankalp_path(@sankalp), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        Edit
      <% end %>
      <%= button_to admin_sankalp_path(@sankalp), method: :delete, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500", data: { turbo_confirm: "Are you sure?" } do %>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Start Date</dt>
      <dd class="mt-1 text-lg font-semibold text-gray-900"><%= format_short_date(@sankalp.start_date) %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">End Date</dt>
      <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @sankalp.end_date ? format_short_date(@sankalp.end_date) : "Ongoing" %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Current Streak</dt>
      <dd class="mt-1 text-lg font-semibold text-orange-500">🔥 <%= @sankalp.current_streak %> days</dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Progress</dt>
      <dd class="mt-1 text-lg font-semibold text-indigo-600"><%= @sankalp.completion_percentage %>%</dd>
    </div>
  </div>

  <% if @sankalp.description.present? %>
    <div class="overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-sm font-medium text-gray-500 mb-2">Description</h3>
        <p class="text-gray-900"><%= @sankalp.description %></p>
      </div>
    </div>
  <% end %>

  <!-- Activities -->
  <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 rounded-lg">
    <div class="bg-white px-4 py-5 sm:px-6 border-b border-gray-200">
      <h3 class="text-base font-semibold leading-6 text-gray-900">Daily Activities</h3>
    </div>
    <% if @daily_activities.any? %>
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Date</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @daily_activities.each do |activity| %>
            <tr>
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                <%= format_date(activity.activity_date) %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <%= completion_badge(activity.completed) %>
              </td>
              <td class="px-3 py-4 text-sm text-gray-500 max-w-xs truncate">
                <%= activity.notes.presence || "-" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="bg-white px-4 py-12 text-center">
        <p class="text-sm text-gray-500">No activities recorded yet.</p>
      </div>
    <% end %>
  </div>

  <%= render "shared/pagination" %>
</div>
