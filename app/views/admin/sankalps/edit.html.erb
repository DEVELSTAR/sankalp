<% content_for :title, "Edit Sankalp - Admin" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Edit Sankalp</h1>
    <p class="mt-1 text-sm text-gray-500">Update Sankalp details.</p>
  </div>

  <%= form_with model: [:admin, @sankalp], class: "space-y-6" do |f| %>
    <% if @sankalp.errors.any? %>
      <div class="rounded-md bg-red-50 p-4">
        <ul class="text-sm text-red-700 list-disc pl-5">
          <% @sankalp.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl">
      <div class="px-4 py-6 sm:p-8">
        <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
          <div class="col-span-full">
            <%= f.label :title, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.text_field :title, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
          </div>

          <div class="col-span-full">
            <%= f.label :description, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.text_area :description, rows: 3, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :category_id, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.collection_select :category_id, @categories, :id, :name, {}, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :status, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.select :status, SankalpRecord.statuses.keys.map { |s| [s.humanize, s] }, {}, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :start_date, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.date_field :start_date, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
          </div>

          <div class="sm:col-span-3">
            <%= f.label :end_date, class: "block text-sm font-medium leading-6 text-gray-900" %>
            <%= f.date_field :end_date, class: "mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-x-4 border-t border-gray-900/10 px-4 py-4 sm:px-8">
        <%= link_to "Cancel", admin_sankalp_path(@sankalp), class: "text-sm font-semibold text-gray-900" %>
        <%= f.submit "Update Sankalp", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>
