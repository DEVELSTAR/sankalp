<%= form_with model: [:admin, category], class: "space-y-6" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <ul class="text-sm text-red-700 list-disc pl-5">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl">
    <div class="px-4 py-6 sm:p-8">
      <div class="grid grid-cols-1 gap-x-6 gap-y-8">
        <div>
          <%= f.label :name, class: "block text-sm font-medium leading-6 text-gray-900" %>
          <%= f.text_field :name, class: "mt-2 block w-full rounded-md border-0 py-1.5 px-4 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :description, class: "block text-sm font-medium leading-6 text-gray-900" %>
          <%= f.text_area :description, rows: 3, class: "mt-2 block w-full rounded-md border-0 py-1.5 px-4 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :color, class: "block text-sm font-medium leading-6 text-gray-900" %>
          <div class="mt-2 flex items-center gap-3">
            <%= f.color_field :color, class: "h-10 w-16 rounded border border-gray-300 cursor-pointer" %>
            <%= f.text_field :color, class: "block w-32 rounded-md border-0 py-1.5 px-4 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm", placeholder: "#6366f1" %>
          </div>
        </div>

        <div>
          <%= f.label :icon, class: "block text-sm font-medium leading-6 text-gray-900" %>
          <%= f.text_field :icon, class: "mt-2 block w-full rounded-md border-0 py-1.5 px-4 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm", placeholder: "star" %>
          <p class="mt-1 text-xs text-gray-500">Enter an icon name (e.g., star, heart, book)</p>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-x-4 border-t border-gray-900/10 px-4 py-4 sm:px-8">
      <%= link_to "Cancel", admin_categories_path, class: "text-sm font-semibold text-gray-900" %>
      <%= f.submit category.persisted? ? "Update Category" : "Create Category", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 cursor-pointer" %>
    </div>
  </div>
<% end %>
