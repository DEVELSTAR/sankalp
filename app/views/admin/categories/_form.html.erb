<%= form_with model: [:admin, category], class: "space-y-6" do |f| %>
  <% if category.errors.any? %>
    <div class="rounded-xl bg-red-50 border border-red-200 p-4">
      <div class="flex gap-3">
        <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
        <div>
          <h3 class="text-sm font-medium text-red-800">Please correct the following:</h3>
          <ul class="mt-2 text-sm text-red-700 list-disc pl-5 space-y-1">
            <% category.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white shadow-sm border border-gray-100 rounded-2xl overflow-hidden">
    <div class="px-8 py-6 space-y-6">
      <!-- Name -->
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :name, 
            class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent",
            placeholder: "Health & Fitness" %>
      </div>

      <!-- Description -->
      <div>
        <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :description, 
            rows: 3,
            class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none",
            placeholder: "A brief description of this category..." %>
      </div>

      <!-- Color and Icon Grid -->
      <div class="grid grid-cols-2 gap-4">
        <!-- Color Picker -->
        <div>
          <%= f.label :color, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <div class="flex gap-3">
            <%= f.color_field :color, 
                class: "h-11 w-16 rounded-xl border-2 border-gray-200 cursor-pointer",
                value: category.color || "#6366f1" %>
            <%= f.text_field :color, 
                class: "flex-1 px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent font-mono text-sm",
                placeholder: "#6366f1",
                value: category.color || "#6366f1" %>
          </div>
        </div>

        <!-- Icon -->
        <div>
          <%= f.label :icon, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :icon, 
              class: "w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent",
              placeholder: "⭐" %>
          <p class="mt-1 text-xs text-gray-500">Use an emoji or icon</p>
        </div>
      </div>

      <!-- Preview -->
      <div class="p-4 bg-gray-50 rounded-xl border border-gray-100">
        <p class="text-xs font-medium text-gray-600 mb-3">Preview</p>
        <div class="flex items-center gap-3 p-3 bg-white rounded-lg border border-gray-200">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xl shadow-sm" 
               style="background-color: <%= category.color || '#6366f1' %>20;">
            <% icon_value = (category.icon.to_s.strip.presence || '⭐') %>
            <% if icon_value.length <= 2 %>
              <span id="icon-preview"><%= icon_value %></span>
            <% else %>
              <span id="icon-preview" class="text-sm font-bold" style="color: <%= category.color || '#6366f1' %>;">
                <%= (category.name.presence || 'C')[0].upcase %>
              </span>
            <% end %>
          </div>
          <div>
            <p class="font-medium text-gray-900"><span id="name-preview"><%= category.name.presence || 'Category Name' %></span></p>
            <div class="flex items-center gap-2 mt-1">
              <div class="w-3 h-3 rounded" style="background-color: <%= category.color || '#6366f1' %>;"></div>
              <span class="text-xs font-mono text-gray-500"><span id="color-preview"><%= category.color || '#6366f1' %></span></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="px-8 py-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-3">
      <%= link_to "Cancel", admin_categories_path, 
          class: "px-4 py-2 text-gray-700 hover:text-gray-900 font-medium text-sm transition-colors" %>
      <%= f.submit category.persisted? ? "Update Category" : "Create Category", 
          class: "px-6 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-colors text-sm font-medium shadow-sm cursor-pointer" %>
    </div>
  </div>
<% end %>

<script>
  // Live preview updates
  document.addEventListener('turbo:load', () => {
    const nameInput = document.querySelector('input[name="category[name]"]');
    const colorInput = document.querySelectorAll('input[name="category[color]"]');
    const iconInput = document.querySelector('input[name="category[icon]"]');
    const iconPreview = document.getElementById('icon-preview');
    
    function updateIconPreview(iconValue, categoryName, categoryColor) {
      const icon = iconValue ? iconValue.trim() : '';
      
      if (icon.length > 0 && icon.length <= 2) {
        // Show emoji
        iconPreview.textContent = icon;
        iconPreview.className = '';
        iconPreview.style.color = '';
      } else {
        // Show first letter
        const firstLetter = categoryName ? categoryName[0].toUpperCase() : 'C';
        iconPreview.textContent = firstLetter;
        iconPreview.className = 'text-sm font-bold';
        iconPreview.style.color = categoryColor || '#6366f1';
      }
    }
    
    if (nameInput) {
      nameInput.addEventListener('input', (e) => {
        const nameValue = e.target.value || 'Category Name';
        document.getElementById('name-preview').textContent = nameValue;
        // Update icon preview if showing first letter
        const currentIcon = iconInput ? iconInput.value : '';
        const currentColor = document.querySelector('input[name="category[color]"][type="text"]').value || '#6366f1';
        updateIconPreview(currentIcon, nameValue, currentColor);
      });
    }
    
    colorInput.forEach(input => {
      input.addEventListener('input', (e) => {
        const color = e.target.value;
        document.getElementById('color-preview').textContent = color;
        document.querySelectorAll('[style*="background-color"]').forEach(el => {
          if (el.style.backgroundColor.includes('20')) {
            el.style.backgroundColor = color + '20';
          } else {
            el.style.backgroundColor = color;
          }
        });
        // Sync color inputs
        colorInput.forEach(ci => ci.value = color);
        
        // Update icon preview color if showing first letter
        const currentIcon = iconInput ? iconInput.value : '';
        const categoryName = nameInput ? nameInput.value : 'Category Name';
        updateIconPreview(currentIcon, categoryName, color);
      });
    });
    
    if (iconInput) {
      iconInput.addEventListener('input', (e) => {
        const categoryName = nameInput ? nameInput.value : 'Category Name';
        const categoryColor = document.querySelector('input[name="category[color]"][type="text"]').value || '#6366f1';
        updateIconPreview(e.target.value, categoryName, categoryColor);
      });
    }
  });
</script>
