<% content_for :page_title, "New Category" %>
<% content_for :page_description, "Create a new global category" %>

<!-- Back Button -->
<div class="mb-6">
  <%= link_to admin_categories_path, class: "inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
    </svg>
    Back to Categories
  <% end %>
</div>

<div class="max-w-2xl">
  <%= render "form", category: @category %>
</div>
