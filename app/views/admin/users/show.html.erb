<% content_for :page_title, @user.full_name %>
<% content_for :page_description, @user.email %>

<!-- Back Button -->
<div class="mb-6">
  <%= link_to admin_users_path, class: "inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
    </svg>
    Back to Users
  <% end %>
</div>

<!-- User Profile Card -->
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden mb-6">
  <div class="bg-gradient-to-r from-indigo-500 to-purple-500 px-8 py-12 text-white">
    <div class="flex items-center gap-6">
      <div class="w-20 h-20 rounded-full bg-white flex items-center justify-center text-indigo-600 font-bold text-3xl shadow-xl">
        <%= @user.first_name[0].upcase %><%= @user.last_name[0].upcase %>
      </div>
      <div>
        <h1 class="text-3xl font-bold mb-2"><%= @user.full_name %></h1>
        <p class="text-indigo-100"><%= @user.email %></p>
        <span class="mt-3 inline-block px-4 py-1 rounded-full text-sm font-medium <%= @user.admin? ? 'bg-white bg-opacity-20' : 'bg-white bg-opacity-20' %>">
          <%= @user.admin? ? '👑 Admin' : '👤 User' %>
        </span>
      </div>
    </div>
  </div>
  
  <!-- Actions Bar -->
  <div class="px-8 py-4 bg-gray-50 border-b border-gray-100 flex items-center gap-3">
    <%= link_to "Edit Profile", edit_admin_user_path(@user), 
        class: "px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors text-sm font-medium" %>
    
    <% unless @user == current_user %>
      <%= button_to "Delete User", admin_user_path(@user), 
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this user?" } },
          class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm font-medium" %>
    <% end %>
  </div>
  
  <!-- Stats Grid -->
  <div class="grid grid-cols-4 divide-x divide-gray-100">
    <div class="p-6 text-center">
      <p class="text-3xl font-bold text-gray-900"><%= @sankalps.count %></p>
      <p class="text-sm text-gray-500 mt-1">Sankalps</p>
    </div>
    <div class="p-6 text-center">
      <p class="text-3xl font-bold text-gray-900"><%= @categories.count %></p>
      <p class="text-sm text-gray-500 mt-1">Categories</p>
    </div>
    <div class="p-6 text-center">
      <p class="text-3xl font-bold text-gray-900"><%= @activities.count %></p>
      <p class="text-sm text-gray-500 mt-1">Activities</p>
    </div>
    <div class="p-6 text-center">
      <p class="text-3xl font-bold text-gray-900"><%= @rewards.count %></p>
      <p class="text-sm text-gray-500 mt-1">Rewards</p>
    </div>
  </div>
</div>

<!-- Two Column Layout -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Recent Sankalps -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
    <div class="px-6 py-4 border-b border-gray-100">
      <h3 class="text-lg font-semibold text-gray-900">Recent Sankalps</h3>
    </div>
    <div class="p-6 space-y-3">
      <% if @sankalps.any? %>
        <% @sankalps.limit(5).each do |sankalp| %>
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-gray-50 transition-colors">
            <div class="flex-1">
              <p class="font-medium text-gray-900"><%= sankalp.title %></p>
              <p class="text-xs text-gray-500"><%= sankalp.category.name %></p>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-medium <%= sankalp.active? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>">
              <%= sankalp.status.humanize %>
            </span>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-gray-500 text-sm py-8">No sankalps yet</p>
      <% end %>
    </div>
  </div>

  <!-- Recent Rewards -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100">
    <div class="px-6 py-4 border-b border-gray-100">
      <h3 class="text-lg font-semibold text-gray-900">Recent Rewards</h3>
    </div>
    <div class="p-6 space-y-3">
      <% if @rewards.any? %>
        <% @rewards.each do |reward| %>
          <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
            <div class="text-2xl"><%= reward.icon || '🏆' %></div>
            <div class="flex-1">
              <p class="font-medium text-gray-900"><%= reward.title %></p>
              <p class="text-xs text-gray-500 mt-1"><%= reward.message %></p>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center text-gray-500 text-sm py-8">No rewards yet</p>
      <% end %>
    </div>
  </div>
</div>
