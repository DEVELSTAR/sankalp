<% content_for :title, "#{@user.full_name} - Admin" %>

<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div class="flex items-center">
      <div class="h-16 w-16 flex-shrink-0 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-xl">
        <%= @user.first_name[0].upcase %><%= @user.last_name[0].upcase %>
      </div>
      <div class="ml-4">
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
          <%= @user.full_name %>
          <%= role_badge(@user.role) %>
        </h1>
        <p class="text-sm text-gray-500"><%= @user.email %></p>
      </div>
    </div>
    <div class="mt-4 flex space-x-3 sm:mt-0">
      <%= link_to edit_admin_user_path(@user), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
        </svg>
        Edit
      <% end %>
      <% unless @user == current_user %>
        <%= button_to admin_user_path(@user), method: :delete, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500", data: { turbo_confirm: "Are you sure you want to delete this user?" } do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5z" clip-rule="evenodd" />
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Total Sankalps</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @sankalps.count %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Active</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-green-600"><%= @user.sankalps.active.count %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Completed</dt>
      <dd class="mt-1 text-3xl font-semibold tracking-tight text-blue-600"><%= @user.sankalps.completed.count %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white px-4 py-5 shadow sm:p-6">
      <dt class="truncate text-sm font-medium text-gray-500">Member Since</dt>
      <dd class="mt-1 text-lg font-semibold tracking-tight text-gray-900"><%= @user.created_at.strftime("%b %d, %Y") %></dd>
    </div>
  </div>

  <!-- Sankalps -->
  <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 rounded-lg">
    <div class="bg-white px-4 py-5 sm:px-6 border-b border-gray-200">
      <h3 class="text-base font-semibold leading-6 text-gray-900">User's Sankalps</h3>
    </div>
    <% if @sankalps.any? %>
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Title</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Category</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Progress</th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @sankalps.each do |sankalp| %>
            <tr>
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                <%= sankalp.title %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <div class="flex items-center">
                  <span class="inline-block w-3 h-3 rounded-full mr-2" style="background-color: <%= sankalp.category.color %>"></span>
                  <%= sankalp.category.name %>
                </div>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <%= status_badge(sankalp.status) %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                <div class="flex items-center">
                  <div class="w-24 bg-gray-200 rounded-full h-2 mr-2">
                    <div class="bg-indigo-600 h-2 rounded-full" style="width: <%= sankalp.completion_percentage %>%"></div>
                  </div>
                  <span><%= sankalp.completion_percentage %>%</span>
                </div>
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                <%= link_to "View", admin_sankalp_path(sankalp), class: "text-indigo-600 hover:text-indigo-900" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="bg-white px-4 py-12 text-center">
        <p class="text-sm text-gray-500">This user has no Sankalps yet.</p>
      </div>
    <% end %>
  </div>

  <%= render "shared/pagination" %>
</div>
