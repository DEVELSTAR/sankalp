<% content_for :page_title, "Dashboard" %>
<% content_for :page_description, "Overview of your platform" %>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <!-- Total Users -->
  <div class="group relative overflow-hidden bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
    <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-white opacity-10"></div>
    <div class="relative">
      <div class="flex items-center justify-between mb-2">
        <svg class="w-10 h-10 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <%= link_to admin_users_path, class: "opacity-0 group-hover:opacity-100 transition-opacity" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <p class="text-3xl font-bold mb-1"><%= @total_users %></p>
      <p class="text-sm opacity-90">Total Users</p>
    </div>
  </div>

  <!-- Total Categories -->
  <div class="group relative overflow-hidden bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
    <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-white opacity-10"></div>
    <div class="relative">
      <div class="flex items-center justify-between mb-2">
        <svg class="w-10 h-10 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
        </svg>
        <%= link_to admin_categories_path, class: "opacity-0 group-hover:opacity-100 transition-opacity" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <p class="text-3xl font-bold mb-1"><%= @total_categories %></p>
      <p class="text-sm opacity-90">Categories</p>
    </div>
  </div>

  <!-- Admin Sankalps -->
  <div class="group relative overflow-hidden bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
    <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-white opacity-10"></div>
    <div class="relative">
      <div class="flex items-center justify-between mb-2">
        <svg class="w-10 h-10 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <%= link_to sankalps_path, class: "opacity-0 group-hover:opacity-100 transition-opacity" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        <% end %>
      </div>
      <p class="text-3xl font-bold mb-1"><%= @admin_sankalps.count %></p>
      <p class="text-sm opacity-90">My Sankalps</p>
    </div>
  </div>

  <!-- Admin Rewards -->
  <div class="group relative overflow-hidden bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl p-6 text-white shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
    <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-white opacity-10"></div>
    <div class="relative">
      <div class="flex items-center justify-between mb-2">
        <svg class="w-10 h-10 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
        </svg>
      </div>
      <p class="text-3xl font-bold mb-1"><%= @admin_rewards.count %></p>
      <p class="text-sm opacity-90">Rewards Earned</p>
    </div>
  </div>
</div>

<!-- Two Column Layout -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  <!-- Recent Users -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">Recent Users</h3>
      <%= link_to admin_users_path, class: "text-sm text-indigo-600 hover:text-indigo-700 font-medium" do %>
        View all →
      <% end %>
    </div>
    
    <div class="divide-y divide-gray-100">
      <% if @recent_users.any? %>
        <% @recent_users.each do |user| %>
          <div class="px-6 py-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-500 flex items-center justify-center text-white font-semibold">
                  <%= user.first_name[0].upcase %>
                </div>
                <div>
                  <p class="font-medium text-gray-900"><%= user.full_name %></p>
                  <p class="text-sm text-gray-500"><%= user.email %></p>
                </div>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-medium <%= user.admin? ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700' %>">
                <%= user.role.humanize %>
              </span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="px-6 py-12 text-center text-gray-500">
          <p class="text-sm">No users yet</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Categories Overview -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-gray-900">Categories</h3>
      <%= link_to admin_categories_path, class: "text-sm text-indigo-600 hover:text-indigo-700 font-medium" do %>
        Manage →
      <% end %>
    </div>
    
    <div class="p-6 space-y-3">
      <% if @categories.any? %>
        <% @categories.limit(6).each do |category| %>
          <div class="flex items-center justify-between p-3 rounded-xl hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center text-xl" style="background-color: <%= category.color %>20;">
                <% icon = category.icon.to_s.strip %>
                <% # Only show icon if it's 1-2 characters (likely emoji), otherwise show initial %>
                <% if icon.present? && icon.length <= 2 %>
                  <%= icon %>
                <% else %>
                  <span class="text-xs font-bold" style="color: <%= category.color %>;">
                    <%= category.name[0].upcase %>
                  </span>
                <% end %>
              </div>
              <div>
                <p class="font-medium text-gray-900"><%= category.name %></p>
                <% if category.respond_to?(:sankalps_count) %>
                  <p class="text-xs text-gray-500"><%= category.sankalps_count %> sankalps</p>
                <% end %>
              </div>
            </div>
            <div class="w-2 h-2 rounded-full" style="background-color: <%= category.color %>;"></div>
          </div>
        <% end %>
      <% else %>
        <div class="py-12 text-center text-gray-500">
          <p class="text-sm">No categories yet</p>
          <%= link_to "Create First Category", new_admin_category_path, class: "mt-2 inline-block text-sm text-indigo-600 hover:text-indigo-700 font-medium" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
