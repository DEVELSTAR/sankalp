<% content_for :title, "Dashboard - Sankalp" %>

<div class="space-y-8">
  <!-- Header -->
  <div class="md:flex md:items-center md:justify-between">
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
        Welcome back, <%= current_user.first_name %>! 👋
      </h1>
      <p class="mt-1 text-sm text-gray-500">
        Here's an overview of your Sankalps for today
      </p>
    </div>
    <div class="mt-4 flex md:ml-4 md:mt-0">
      <%= link_to new_sankalp_path, class: "inline-flex items-center rounded-md bg-gradient-to-r from-indigo-600 to-purple-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:from-indigo-500 hover:to-purple-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all duration-200" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New Sankalp
      <% end %>
    </div>
  </div>

  <!-- Stats cards -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Total Sankalps -->
    <div class="relative overflow-hidden rounded-xl bg-white px-4 py-5 shadow-sm border border-gray-100 sm:p-6">
      <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-indigo-50"></div>
      <dt class="truncate text-sm font-medium text-gray-500">Total Sankalps</dt>
      <dd class="mt-1 text-3xl font-bold tracking-tight text-gray-900"><%= @total_sankalps %></dd>
      <div class="mt-2">
        <span class="text-sm text-gray-500"><%= @completed_sankalps %> completed</span>
      </div>
    </div>

    <!-- Active Sankalps -->
    <div class="relative overflow-hidden rounded-xl bg-white px-4 py-5 shadow-sm border border-gray-100 sm:p-6">
      <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-green-50"></div>
      <dt class="truncate text-sm font-medium text-gray-500">Active Sankalps</dt>
      <dd class="mt-1 text-3xl font-bold tracking-tight text-gray-900"><%= @active_sankalps.count %></dd>
      <div class="mt-2">
        <span class="text-sm text-green-600">In progress</span>
      </div>
    </div>

    <!-- Today's Activities -->
    <div class="relative overflow-hidden rounded-xl bg-white px-4 py-5 shadow-sm border border-gray-100 sm:p-6">
      <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-yellow-50"></div>
      <dt class="truncate text-sm font-medium text-gray-500">Pending Today</dt>
      <dd class="mt-1 text-3xl font-bold tracking-tight text-gray-900"><%= @today_pending.count %></dd>
      <div class="mt-2">
        <span class="text-sm text-yellow-600">Activities to complete</span>
      </div>
    </div>

    <!-- Completion Rate -->
    <div class="relative overflow-hidden rounded-xl bg-white px-4 py-5 shadow-sm border border-gray-100 sm:p-6">
      <div class="absolute top-0 right-0 -mt-4 -mr-4 h-24 w-24 rounded-full bg-purple-50"></div>
      <dt class="truncate text-sm font-medium text-gray-500">Completion Rate</dt>
      <dd class="mt-1 text-3xl font-bold tracking-tight text-gray-900">
        <%= @total_activities > 0 ? ((@completed_activities.to_f / @total_activities) * 100).round(1) : 0 %>%
      </dd>
      <div class="mt-2">
        <span class="text-sm text-purple-600"><%= @completed_activities %>/<%= @total_activities %> activities</span>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Today's Pending Activities -->
    <div class="rounded-xl bg-white shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-100">
        <h3 class="text-base font-semibold leading-6 text-gray-900 flex items-center">
          <svg class="h-5 w-5 text-yellow-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Today's Pending (<%= @today_pending.count %>)
        </h3>
      </div>
      <div class="divide-y divide-gray-100">
        <% if @today_pending.any? %>
          <% @today_pending.first(5).each do |sankalp| %>
            <div class="px-4 py-4 sm:px-6 hover:bg-gray-50 transition-colors">
              <div class="flex items-center justify-between">
                <div class="flex items-center min-w-0 flex-1">
                  <span class="inline-block w-3 h-3 rounded-full mr-3 flex-shrink-0" style="background-color: <%= sankalp.category.color %>"></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-gray-900 truncate"><%= sankalp.title %></p>
                    <p class="text-xs text-gray-500"><%= sankalp.category.name %></p>
                  </div>
                </div>
                <%= link_to new_sankalp_daily_activity_path(sankalp, activity_date: Date.current), class: "ml-4 inline-flex items-center rounded-md bg-indigo-50 px-2.5 py-1.5 text-xs font-medium text-indigo-700 hover:bg-indigo-100 transition-colors" do %>
                  Log Activity
                <% end %>
              </div>
            </div>
          <% end %>
          <% if @today_pending.count > 5 %>
            <div class="px-4 py-3 text-center">
              <%= link_to sankalps_path(status: 'active'), class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" do %>
                View all <%= @today_pending.count %> pending
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="px-4 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="mt-2 text-sm font-semibold text-gray-900">All caught up!</h3>
            <p class="mt-1 text-sm text-gray-500">You've completed all activities for today.</p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Active Sankalps -->
    <div class="rounded-xl bg-white shadow-sm border border-gray-100 overflow-hidden">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-100">
        <h3 class="text-base font-semibold leading-6 text-gray-900 flex items-center">
          <svg class="h-5 w-5 text-indigo-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
          </svg>
          Active Sankalps
        </h3>
      </div>
      <div class="divide-y divide-gray-100">
        <% if @active_sankalps.any? %>
          <% @active_sankalps.each do |sankalp| %>
            <%= link_to sankalp, class: "block px-4 py-4 sm:px-6 hover:bg-gray-50 transition-colors" do %>
              <div class="flex items-center justify-between">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center">
                    <span class="inline-block w-3 h-3 rounded-full mr-3" style="background-color: <%= sankalp.category.color %>"></span>
                    <p class="text-sm font-medium text-gray-900 truncate"><%= sankalp.title %></p>
                  </div>
                  <div class="mt-2">
                    <%= progress_bar(sankalp.completion_percentage) %>
                  </div>
                  <div class="mt-2 flex items-center text-xs text-gray-500">
                    <span><%= sankalp.completion_percentage %>% complete</span>
                    <span class="mx-2">•</span>
                    <span><%= streak_display(sankalp.current_streak) %></span>
                  </div>
                </div>
                <svg class="h-5 w-5 text-gray-400 ml-4" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                </svg>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="px-4 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="mt-2 text-sm font-semibold text-gray-900">No active Sankalps</h3>
            <p class="mt-1 text-sm text-gray-500">Start your journey by creating a new Sankalp.</p>
            <div class="mt-4">
              <%= link_to new_sankalp_path, class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
                <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                Create Sankalp
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="rounded-xl bg-white shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-100">
      <h3 class="text-base font-semibold leading-6 text-gray-900 flex items-center">
        <svg class="h-5 w-5 text-gray-500 mr-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Recent Activity
      </h3>
    </div>
    <div class="divide-y divide-gray-100">
      <% if @recent_activities.any? %>
        <% @recent_activities.each do |activity| %>
          <div class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center min-w-0 flex-1">
                <%= completion_badge(activity.completed) %>
                <div class="ml-3 min-w-0 flex-1">
                  <p class="text-sm font-medium text-gray-900 truncate"><%= activity.sankalp.title %></p>
                  <p class="text-xs text-gray-500"><%= format_date(activity.activity_date) %></p>
                </div>
              </div>
              <% if activity.notes.present? %>
                <p class="ml-4 text-xs text-gray-500 max-w-xs truncate hidden sm:block"><%= activity.notes %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="px-4 py-12 text-center">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-gray-900">No activity yet</h3>
          <p class="mt-1 text-sm text-gray-500">Start logging your daily activities.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
