<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <title>Admin - Sankalp</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Admin Dashboard - Sankalp">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body class="h-full overflow-hidden">
  <div class="flex h-full">
    <!-- Minimal Sidebar -->
    <aside class="w-20 bg-gradient-to-b from-indigo-600 to-indigo-800 flex flex-col items-center py-8 space-y-8">
      <!-- Logo -->
      <div class="flex items-center justify-center w-12 h-12 bg-white rounded-xl shadow-lg">
        <span class="text-2xl">🎯</span>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 flex flex-col items-center space-y-6">
        <%= link_to admin_root_path, 
            class: "flex items-center justify-center w-12 h-12 rounded-xl transition-all duration-200 #{current_page?(admin_root_path) ? 'bg-white text-indigo-600 shadow-lg' : 'text-white hover:bg-indigo-500'}", 
            title: "Dashboard" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
        <% end %>

        <%= link_to admin_users_path, 
            class: "flex items-center justify-center w-12 h-12 rounded-xl transition-all duration-200 #{current_page?(admin_users_path) ? 'bg-white text-indigo-600 shadow-lg' : 'text-white hover:bg-indigo-500'}", 
            title: "Users" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        <% end %>

        <%= link_to admin_categories_path, 
            class: "flex items-center justify-center w-12 h-12 rounded-xl transition-all duration-200 #{current_page?(admin_categories_path) ? 'bg-white text-indigo-600 shadow-lg' : 'text-white hover:bg-indigo-500'}", 
            title: "Categories" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
          </svg>
        <% end %>
      </nav>

      <!-- User Profile -->
      <div class="relative group">
        <div class="flex items-center justify-center w-12 h-12 bg-white rounded-xl shadow-lg cursor-pointer transition-transform hover:scale-105">
          <span class="text-lg font-semibold text-indigo-600">
            <%= current_user.first_name[0].upcase %>
          </span>
        </div>
        
        <!-- Logout on hover -->
        <div class="absolute bottom-full left-full ml-4 mb-0 opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none group-hover:pointer-events-auto">
          <%= button_to destroy_user_session_path, 
              method: :delete,
              data: { turbo: false },
              class: "bg-white text-red-600 px-4 py-2.5 rounded-lg shadow-xl border border-red-100 text-sm font-medium hover:bg-red-50 whitespace-nowrap transition-colors flex items-center gap-2" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Sign Out
          <% end %>
        </div>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto">
      <!-- Top Bar -->
      <div class="bg-white border-b border-gray-200 px-8 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900"><%= content_for?(:page_title) ? yield(:page_title) : 'Admin Dashboard' %></h1>
            <p class="text-sm text-gray-500 mt-1"><%= content_for?(:page_description) ? yield(:page_description) : 'Manage your application' %></p>
          </div>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if flash.any? %>
        <div class="px-8 py-4">
          <% flash.each do |type, message| %>
            <div class="<%= type == 'notice' ? 'bg-green-50 border-green-200 text-green-800' : 'bg-red-50 border-red-200 text-red-800' %> border rounded-lg px-4 py-3 mb-4 flex items-center gap-3">
              <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <% if type == 'notice' %>
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                <% else %>
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                <% end %>
              </svg>
              <span class="text-sm font-medium"><%= message %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Page Content -->
      <div class="px-8 py-6">
        <%= yield %>
      </div>
    </main>
  </div>
</body>
</html>
