<!DOCTYPE html>
<html class="h-full bg-gray-100">
  <head>
    <title><%= content_for(:title) || "Admin - Sankalp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-sans antialiased">
    <div class="min-h-full">
      <!-- Admin Navbar -->
      <nav class="bg-gray-800">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="flex h-16 items-center justify-between">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <%= link_to admin_root_path, class: "flex items-center" do %>
                  <span class="text-2xl">🎯</span>
                  <span class="ml-2 text-xl font-bold text-white">Sankalp</span>
                  <span class="ml-2 px-2 py-0.5 text-xs font-medium bg-purple-600 text-white rounded">Admin</span>
                <% end %>
              </div>
              <div class="hidden md:block">
                <div class="ml-10 flex items-baseline space-x-4">
                  <%= link_to "Dashboard", admin_root_path, class: "rounded-md px-3 py-2 text-sm font-medium #{controller_name == 'dashboard' ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" %>
                  <%= link_to "Users", admin_users_path, class: "rounded-md px-3 py-2 text-sm font-medium #{controller_name == 'users' ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" %>
                  <%= link_to "Sankalps", admin_sankalps_path, class: "rounded-md px-3 py-2 text-sm font-medium #{controller_name == 'sankalps' ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" %>
                  <%= link_to "Categories", admin_categories_path, class: "rounded-md px-3 py-2 text-sm font-medium #{controller_name == 'categories' ? 'bg-gray-900 text-white' : 'text-gray-300 hover:bg-gray-700 hover:text-white'}" %>
                </div>
              </div>
            </div>
            <div class="hidden md:block">
              <div class="ml-4 flex items-center md:ml-6">
                <%= link_to root_path, class: "rounded-md px-3 py-2 text-sm font-medium text-gray-300 hover:bg-gray-700 hover:text-white" do %>
                  <svg class="h-5 w-5 inline-block mr-1" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                  </svg>
                  Back to App
                <% end %>
                <div class="h-5 w-px bg-gray-600 mx-2"></div>
                <div class="flex items-center">
                  <div class="h-8 w-8 rounded-full bg-gradient-to-r from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm">
                    <%= current_user.first_name[0].upcase %><%= current_user.last_name[0].upcase %>
                  </div>
                  <span class="ml-2 text-sm text-gray-300"><%= current_user.first_name %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <main>
        <div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8">
          <%= render "shared/flash_messages" %>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
